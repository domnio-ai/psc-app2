PORT=8000
NODE_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5173
AI_RESEARCH_URL=http://127.0.0.1:8100
FELIX_INDEX_INTERVAL_MS=5000
FELIX_INDEX_RECONCILE_MS=300000
FELIX_INDEX_TIMEOUT_MS=360000
