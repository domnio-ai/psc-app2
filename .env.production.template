# Copy to .env.production on the deployment host, then replace all example values.
# Keep .env.production private and out of source control.
POSTGRES_DB=redesy_production
POSTGRES_USER=redesy_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h

# Reverse proxy/TLS configuration. Bind web to loopback when TLS is terminated
# by a reverse proxy on this same host. Use 0.0.0.0 only for a protected LAN.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
FRONTEND_ORIGIN=https://your-domain.example
MAX_UPLOAD_MB=100

# Keep optional background jobs off until their production behavior is reviewed.
FELIX_INDEX_WORKER_ENABLED=false
REPORT_SCHEDULER_ENABLED=false
NOTICE_EXPIRY_WORKER_ENABLED=false
RESEARCH_LIFECYCLE_RECONCILIATION_ENABLED=false

# Email is off until an approved SMTP provider and sender are configured.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PSC App2 <no-reply@example.invalid>
